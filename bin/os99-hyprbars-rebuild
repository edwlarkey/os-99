#!/bin/bash
# Rebuild the forked hyprbars against the running Hyprland.
#
# Hyprland plugins are ABI-pinned: after a Hyprland upgrade the .so stops
# loading and the OS 9 window frames silently disappear. Re-run this, then
# re-apply the theme.
set -e
_os99_lib="$(dirname -- "$(readlink -f "$0")")/os99-lib.sh"
# shellcheck source=os99-lib.sh
source "$_os99_lib" || { echo "os99-hyprbars-rebuild: missing $_os99_lib" >&2; exit 1; }

# The plugin source now lives inside this repository rather than in a separate
# fork checkout, so there is one place to build from. os99_plugin_src knows
# every place it can be -- checkout, package, omarchy plugin dir -- and
# os99-install asks the same function, so there is one answer rather than two
# that can drift. OS99_PLUGIN_SRC still overrides everything.
if ! SRC=$(os99_plugin_src); then
  echo "os99-hyprbars-rebuild: cannot find the hyprbars source." >&2
  echo "  Looked beside this script (../plugin/hyprbars), in the state dir's" >&2
  echo "  plugin-src pointer, in /usr/share/os99/plugin/hyprbars, and in the" >&2
  echo "  omarchy plugin directory." >&2
  echo "  Run this from a checkout, or set OS99_PLUGIN_SRC to plugin/hyprbars." >&2
  exit 1
fi
LIBDIR="$HOME/.local/lib"
PTR="$LIBDIR/libhyprbars-os99.path"      # names the .so the hook should load
BUILT="$LIBDIR/libhyprbars-os99.built"   # names the Hyprland it was built FOR

echo "Hyprland:      $(hyprctl version | head -1)"
echo "pkg-config:    $(pkg-config --modversion hyprland)"
echo "running ABI:   $(os99_hypr_abi || echo '(no compositor answering)')"
echo "source:        $SRC"

cd "$SRC"
# CLEAN FIRST. Not thrift -- correctness.
#
# The Makefile now lists Hyprland's version.h as a prerequisite, so an ABI bump
# with no source change does force a recompile. That dep is found through
# pkg-config, though, and a pkg-config that cannot answer makes it EMPTY, which
# is no prerequisite at all and restores exactly the bug it exists to fix:
# make prints "Nothing to be done for 'all'" and everything below this happily
# content-hashes and installs the STALE object under a fresh name, reporting
# success. (2026-09-09, aquamarine 0.14 -> 0.15. The frames stayed gone and the
# rebuild that was supposed to bring them back said it had worked.)
#
# This is a script somebody runs once per Hyprland upgrade. One full compile of
# five files is the cheapest possible insurance against that.
make clean >/dev/null
make -j"$(nproc)" all

# CRITICAL: every build gets its own filename, keyed by content hash.
#
# Reusing one path does not work, and fails in two different ways. Overwriting
# in place (cp) rewrites the same inode while Hyprland may still have those
# pages mapped -- dlsym then reads a file that changed underneath it and aborts
# the compositor. Replacing by rename avoids that, but Hyprland does not fully
# dlclose an unloaded plugin, so dlopen on a path it has seen before hands back
# the STALE handle and silently keeps running the old code. Both were observed
# on 2026-08-20; the second is the quieter and more confusing one.
#
# A fresh path sidesteps both: nothing is mapped at it, so the load is real.
# VERIFY THE SYMBOLS BEFORE INSTALLING ANYTHING.
#
# A plugin .so legitimately has undefined symbols -- everything it calls in the
# compositor is resolved at dlopen -- so the linker cannot warn, and a missing
# source file yields a .so that builds cleanly and then aborts Hyprland the
# instant it loads:
#
#   Hyprland: symbol lookup error: libhyprbars-os99-*.so:
#     undefined symbol: _Z12parseBorders...
#
# There is no core and no backtrace, so it reads as "the compositor crashed"
# rather than "the build was wrong". That happened for real: upstream's Makefile
# named three sources while its CMakeLists globbed, so ninePatch.cpp stopped
# being compiled the moment this script switched from cmake to make.
#
# So: every symbol the .so needs must be provided by Hyprland, by something
# Hyprland links, or by something we link. Strip @GLIBC_x.y version suffixes on
# both sides or nothing matches. The three __gmon_start__ / _ITM_* entries are
# toolchain stubs that are always unresolved and always harmless.
echo "verifying symbols..."
_norm() { awk '{print $NF}' | sed 's/@.*//' | sort -u; }
# Find the Hyprland binary rather than assuming /usr/bin. NixOS has no /usr/bin
# at all, and hardcoding it would make every Hyprland symbol look unresolved --
# turning this safety check into a false refusal to install. Prefer the RUNNING
# compositor, since that is the one the plugin has to match.
HYPRBIN="${HYPRBIN:-}"
if [[ -z $HYPRBIN ]]; then
  for _hl in $(pgrep -x Hyprland 2>/dev/null); do
    _exe=$(readlink -f "/proc/$_hl/exe" 2>/dev/null) || continue
    [[ -x $_exe ]] && { HYPRBIN="$_exe"; break; }
  done
fi
[[ -n $HYPRBIN ]] || HYPRBIN=$(command -v Hyprland 2>/dev/null || true)
if [[ -z $HYPRBIN ]]; then
  echo "!! cannot locate the Hyprland binary; skipping the symbol check." >&2
  echo "!! Set HYPRBIN=/path/to/Hyprland to re-enable it." >&2
fi

_allowed() {
  { [[ -n $HYPRBIN ]] && nm -D --defined-only "$HYPRBIN" 2>/dev/null
    [[ -n $HYPRBIN ]] && ldd "$HYPRBIN" 2>/dev/null | awk '/=>/{print $3}' | xargs -r -n1 nm -D --defined-only 2>/dev/null
    ldd hyprbars.so    2>/dev/null | awk '/=>/{print $3}' | xargs -r -n1 nm -D --defined-only 2>/dev/null
  } | _norm
}
# `|| true` because this script runs under `set -e` and grep -v exits 1 when it
# filters everything out -- which is precisely the success case here.
MISSING=$(comm -23 <(nm -D --undefined-only hyprbars.so | _norm) <(_allowed) \
          | grep -vE '^(__gmon_start__|_ITM_(de)?registerTMCloneTable)$' || true)
if [[ -n $MISSING ]]; then
  echo "!! REFUSING TO INSTALL -- $(printf '%s\n' "$MISSING" | wc -l) unresolved symbol(s):" >&2
  printf '%s\n' "$MISSING" | head -10 | c++filt | sed 's/^/     /' >&2
  echo "   Almost certainly a .cpp that did not get compiled. SRC in the Makefile" >&2
  echo "   is \$(wildcard *.cpp) -- check every source actually built." >&2
  exit 1
fi
echo "  all symbols resolve"

HASH=$(sha256sum hyprbars.so | cut -c1-12)
NEW="$LIBDIR/libhyprbars-os99-$HASH.so"

mkdir -p "$LIBDIR"

# Unload whatever is live BEFORE repointing.
#
# By the path the compositor actually has MAPPED, not the one the pointer file
# names. Those diverge the moment a rebuild moves the pointer, and unload takes
# the path a plugin was loaded FROM -- so unloading by the pointer is a no-op
# that reports nothing, leaves the old code resident, and makes the load below
# look like it succeeded when it was the previous build answering.
if hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
  while read -r _old; do
    [[ -n $_old ]] || continue
    echo "unloading currently-loaded plugin: $_old"
    hyprctl plugin unload "$_old" >/dev/null 2>&1 || true
  done < <(os99_hyprbars_paths)
  # Fallback for an unreadable /proc: every build ever installed. One of them is
  # the right answer and the rest are no-ops.
  if hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
    for _old in "$(cat "$PTR" 2>/dev/null)" "$LIBDIR"/libhyprbars-os99*.so; do
      [[ -n $_old && -f $_old ]] && hyprctl plugin unload "$_old" >/dev/null 2>&1
    done
  fi
  sleep 1
fi

install -m755 hyprbars.so "$NEW.tmp"
mv -f "$NEW.tmp" "$NEW"
echo "$NEW" > "$PTR"

# Record the Hyprland this was compiled against. Plugins are ABI-pinned, so
# after a Hyprland upgrade the .so simply stops loading and the window frames
# disappear with no error anyone sees. Comparing this against the running
# Hyprland turns that into a diagnosis -- "built for v0.56.2, running v0.57.0"
# -- which is the difference between a bar that offers to fix it and a desktop
# that has quietly lost its title bars.
#
# HYPRLAND_ABI is the field that decides; the tag and commit are for wording.
# The tag is not the pin and comparing it misses whole classes of breakage: on
# 2026-09-09 aquamarine went 0.14 -> 0.15, every plugin on the machine stopped
# loading, and the tag was v0.56.2 on both sides of it. Everything that asks
# "is this build stale" now asks the ABI string, which is the literal thing
# Hyprland compares the plugin against.
{
  echo "SO=$NEW"
  echo "HYPRLAND_ABI=$(os99_hypr_abi || true)"
  echo "HYPRLAND_COMMIT=$(hyprctl version 2>/dev/null | sed -n 's/.*at commit \([0-9a-f]\{7,\}\).*/\1/p' | head -1)"
  echo "HYPRLAND_TAG=$(hyprctl version 2>/dev/null | sed -n 's/^Tag: \([^,]*\).*/\1/p' | head -1)"
  echo "BUILT_AT=$(date -Is)"
} > "$BUILT.tmp" && mv -f "$BUILT.tmp" "$BUILT"

# NEVER delete an old build. That claim -- "safe to remove, the inode stays
# alive" -- is what took the session down a second time on 2026-08-20 with a
# SIGBUS whose top frame was literally
#   /home/j/.local/lib/libhyprbars-os99.so (deleted)
# Hyprland does not fully dlclose a plugin, so its mapping of every .so it has
# ever loaded is still live, and unlinking (or overwriting) the backing file
# makes any not-yet-faulted page unreadable. These are ~470K each; leaving them
# is free. Sweep them by hand when no Hyprland that loaded them is running.

echo "installed -> $NEW"

# PROVE IT LOADS. "Installed" is not the claim anybody wants.
#
# Everything above this verifies the BUILD -- that every symbol resolves, that
# no .cpp went missing. Nothing verified that the compositor would accept the
# result, so a rebuild could print an unbroken run of successes and leave a
# desktop with no window frames, which is exactly what happened on 2026-09-09.
# The ABI pin is checkable in one call, so check it.
#
# THE TEST IS "is $NEW the resident library", not "is some hyprbars loaded".
# Those differ, in both directions. os99-window-bars reloads the plugin on
# hooks this script does not control, so the list can be non-empty again a
# moment after the unload above -- and it can be non-empty because the OLD
# build never left, which is the failure this step exists to catch. Asking
# which path the compositor actually has open separates the two.
#
# Loading here is safe and not a half-measure: os99-window-bars unloads and
# reloads unconditionally, so the theme re-apply below still does its own thing
# afterwards. This just answers the question now instead of at the next login.
if hyprctl version >/dev/null 2>&1; then
  echo "verifying it loads..."
  # An identical rebuild produces an identical hash and therefore the same
  # path, which may already be resident. That is a pass, not a collision: the
  # bytes are the ones we just built, so the handle Hyprland kept is our code.
  if [[ $(os99_loaded_so 2>/dev/null) != "$NEW" ]]; then
    hyprctl plugin load "$NEW" >/dev/null 2>&1 || true
  fi
  if hyprctl plugin list 2>/dev/null | grep -q hyprbars &&
     [[ $(os99_loaded_so 2>/dev/null) == "$NEW" ]]; then
    echo "  loaded"
  else
    echo "!! THE PLUGIN DID NOT LOAD. The frames will not come back." >&2
    if drift=$(os99_abi_stale); then
      built=${drift%%$'\t'*}; running=${drift##*$'\t'}
      echo "   ABI mismatch: $(os99_abi_diff "$built" "$running")" >&2
      echo "   built for: $built" >&2
      echo "   running:   $running" >&2
      echo "   The headers this built against are not the running compositor's." >&2
      echo "   Log out and back in to pick up the upgraded Hyprland, then re-run." >&2
    else
      echo "   The ABI matches, so this is not a version pin. Check:" >&2
      echo "     hyprctl plugin load $NEW" >&2
    fi
    exit 1
  fi
fi

echo "Now: omarchy theme set \"$(omarchy theme current)\""
